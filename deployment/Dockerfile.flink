FROM flink:1.20.2-scala_2.12-java17

USER root

RUN apt-get update && \
    apt-get install -y \
    curl \
    vim \
    netcat-openbsd \

    iputils-ping && \

    rm -rf /var/lib/apt/lists/*

RUN wget \

    -O /opt/flink/lib/flink-sql-connector-kafka-3.3.0-1.20.jar \
    https://repo.maven.apache.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.3.0-1.20/flink-sql-connector-kafka-3.3.0-1.20.jar

RUN chmod 644 \

/opt/flink/lib/flink-sql-connector-kafka-3.3.0-1.20.jar

USER flink